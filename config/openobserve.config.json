{
  "version": "1.0.0",
  "instances": [
    {
      "id": "prod-gcp",
      "name": "Production GCP",
      "url": "https://periscope.breezesdk.store",
      "auth": {
        "type": "env",
        "envVar": "PROD_GCP_O2_TOKEN"
      },
      "defaults": {
        "org": "default",
        "streams": ["default_v2", "curator", "vayu_v2"],
        "timeout": 60000,
        "maxResults": 1000
      },
      "capabilities": ["logs", "traces", "metrics"],
      "tags": ["production", "gcp", "tara", "curator", "vayu"]
    },
    {
      "id": "prod-aws",
      "name": "Production AWS",
      "url": "https://periscope.breeze.in/openobserve",
      "auth": {
        "type": "env",
        "envVar": "PROD_AWS_O2_TOKEN"
      },
      "defaults": {
        "org": "default",
        "streams": [
          "default_v2",
          "curator",
          "vayu_v2",
          "lighthouse",
          "nimble",
          "atoms",
          "automatic"
        ],
        "timeout": 60000,
        "maxResults": 1000
      },
      "capabilities": ["logs", "traces", "metrics"],
      "tags": [
        "production",
        "aws",
        "tara",
        "curator",
        "neurolink",
        "vayu",
        "lighthouse",
        "nimble",
        "atoms",
        "automatic"
      ]
    },
    {
      "id": "beta-aws",
      "name": "Beta AWS",
      "url": "https://periscope.beta.breeze.in/openobserve",
      "auth": {
        "type": "env",
        "envVar": "BETA_AWS_O2_TOKEN"
      },
      "defaults": {
        "org": "default",
        "streams": ["default_v2", "curator", "vayu_v2", "lighthouse", "vinci"],
        "timeout": 60000,
        "maxResults": 1000
      },
      "capabilities": ["logs", "traces", "metrics"],
      "tags": [
        "beta",
        "aws",
        "tara",
        "curator",
        "neurolink",
        "vayu",
        "lighthouse",
        "vinci"
      ]
    }
  ],
  "batching": {
    "maxConcurrent": 5,
    "maxBatchSize": 100,
    "timeout": 120000
  },
  "caching": {
    "enabled": true,
    "ttl": 300,
    "maxSize": 1000
  }
}
